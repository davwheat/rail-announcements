# Public build-time defaults for production. No secrets should be stored here as the values
# are available to the browser.

# Darwin Browser. The client appends /v1/announcements/live and /v1/cis/live.
NEXT_PUBLIC_LIVE_SERVICE_URL=wss://darwinbrowser.com

# raildotmatrix board, which reads the service URL from the liveServiceUrl query parameter.
# Branch previews are served at https://<branch>.raildotmatrix.pages.dev/board.
NEXT_PUBLIC_LIVE_BOARD_URL=https://raildotmatrix.co.uk/board

# rail-announcements-backend, which streams announcements it builds itself. The client appends
# /v1/streams/live.mp3. Setting this is what offers the "Announcement audio" setting in a
# production build, so remove it to withdraw the option.
NEXT_PUBLIC_ANNOUNCEMENT_SERVICE_URL=https://audio.railannouncements.co.uk
