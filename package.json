{
  "name": "rail-announcements-next",
  "version": "1.0.0",
  "private": true,
  "description": "Rail Announcements (Next.js)",
  "author": "David Wheatley",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "STATIC_EXPORT=true next build --webpack && next-sitemap",
    "start": "npx serve out",
    "export": "STATIC_EXPORT=true next build --webpack && next-sitemap",
    "build:ci": "STATIC_EXPORT=true next build --webpack && next-sitemap",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,less}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,less}\"",
    "cf-typegen": "wrangler types --path='./functions/types.d.ts'",
    "serve-audio": "http-server ./audio/ -c-1 --port 8088 --cors",
    "develop:workers": "wrangler pages dev --port 8787"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@reach/tabs": "^0.18.0",
    "@sentry/nextjs": "^10.72.0",
    "@twemoji/svg": "^15.0.0",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "crunker": "^2.4.0",
    "dayjs": "^1.11.23",
    "jotai": "^2.20.3",
    "jotai-family": "^1.1.0",
    "mdi-react": "^9.4.0",
    "nanoid": "^6.0.1",
    "next": "^16.3.3",
    "notistack": "^3.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-fullscreen-crossbrowser": "^1.1.3",
    "react-select": "^5.10.2",
    "uk-railway-stations": "^1.10.0",
    "use-html-dialog": "^0.2.1",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/uuid": "^11.0.0",
    "http-server": "^14.1.1",
    "next-sitemap": "^4.2.3",
    "null-loader": "^4.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.127.1"
  },
  "packageManager": "yarn@4.18.0",
  "resolutions": {
    "react": "^19",
    "react-dom": "^19",
    "@types/react-dom": "^19.2.3"
  }
}
